#!/usr/bin/env python3
import sys
import subprocess
import json
from pathlib import Path
from datetime import datetime

NOVA = Path.home() / "Nova"
CHECKS = NOVA / "status" / "checks"
DATA = NOVA / "dashboard" / "data"
LOGS = NOVA / "logs" / "status"

DATA.mkdir(parents=True, exist_ok=True)
LOGS.mkdir(parents=True, exist_ok=True)

def run_check(path):
    result = subprocess.run([str(path)], text=True, capture_output=True)
    line = result.stdout.strip()

    try:
        state, name, message, url = line.split("|", 3)
    except ValueError:
        state = "ERROR"
        name = path.name
        message = "Bad check output"
        url = ""

    return {
        "id": path.name,
        "name": name,
        "state": state,
        "message": message,
        "url": url,
        "exit_code": result.returncode,
    }

def main():
    target = sys.argv[1].lower() if len(sys.argv) > 1 else None

    checks = sorted([p for p in CHECKS.iterdir() if p.is_file() and p.stat().st_mode & 0o111])

    results = []

    for check in checks:
        if target and target not in check.name.lower():
            continue
        results.append(run_check(check))

    payload = {
        "updated": datetime.now().strftime("%Y-%m-%d %I:%M:%S %p"),
        "systems": results,
    }

    with open(DATA / "status.json", "w") as f:
        json.dump(payload, f, indent=2)

    with open(LOGS / "latest_status.json", "w") as f:
        json.dump(payload, f, indent=2)

    if not results:
        print("No matching status checks found.")
        sys.exit(1)

    for r in results:
        icon = "✅" if r["state"] == "OK" else "❌"
        print(f'{icon} {r["name"]}: {r["message"]}')

    if any(r["state"] != "OK" for r in results):
        sys.exit(1)

if __name__ == "__main__":
    main()
